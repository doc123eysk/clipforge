# ============================================
# ClipForge — Production Environment
# ============================================
# Скопируй в .env на VDS и заполни значения

# База данных (SQLite для простоты, можно заменить на PostgreSQL)
DATABASE_URL="file:./prod.db"

# JWT секрет (СГЕНЕРИРУЙ НОВЫЙ!)
JWT_SECRET="clipforge-production-SUPER-SECRET-KEY-CHANGE-ME"

# FFmpeg (Linux пути)
FFMPEG_PATH="/usr/bin/ffmpeg"
FFPROBE_PATH="/usr/bin/ffprobe"

# S3 хранилище (опционально)
S3_ENDPOINT="https://storage.yandexcloud.net"
S3_BUCKET="clipforge"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="ru-central1"

# Домен (для CORS, превью и т.д.)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
